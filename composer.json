{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "made-foryou/made-cms-package",
    "description": "Content management system from Made",
    "keywords": [
        "laravel",
        "made-foryou",
        "made-cms-package"
    ],
    "homepage": "https://github.com/made-foryou/made-cms-package",
    "license": "MIT",
    "authors": [
        {
            "name": "Made",
            "email": "menno@made-foryou.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/auth": "^12.0||^13.0",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/cookie": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/hashing": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/mail": "^12.0||^13.0",
        "illuminate/notifications": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/session": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0",
        "lorisleiva/laravel-actions": "^2.12",
        "pragmarx/google2fa": "^8.0||^9.0",
        "symfony/html-sanitizer": "^7.4.13||^8.0.13",
        "symfony/http-foundation": "^7.2||^8.0",
        "symfony/http-kernel": "^7.2||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Made\\CmsPackage\\": "src/",
            "Made\\CmsPackage\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Made\\CmsPackage\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --no-cache --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Made\\CmsPackage\\CmsPackageServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
