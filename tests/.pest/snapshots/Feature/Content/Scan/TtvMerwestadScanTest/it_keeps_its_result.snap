    "pages": [
        {
            "url": "/",
            "title": "Welkom - TTV Merwestad",
            "strips": [
                {
                    "type": "strook-1",
                    "selector": "body > div > div > section",
                    "values": {
                        "afbeelding": {
                            "url": "/photos/PHOTO-2024-12-22-10-48-11.jpg",
                            "alt": ""
                        },
                        "label": "Tafeltennisvereniging in Dordrecht",
                        "kop": "TTV Merwestad",
                        "tekst": "Sinds 1962 dé plek voor tafeltennissers van alle niveaus. Van recreant tot competitiespeler — iedereen is welkom aan onze tafels.",
                        "knop": {
                            "text": "Lid worden",
                            "link": {
                                "url": "#lid-worden"
                            }
                        },
                        "knop_2": {
                            "text": "Meer ontdekken",
                            "link": {
                                "url": "#over-ons"
                            }
                        }
                    }
                },
                {
                    "type": "strook-2",
                    "selector": "body > div > div > section:nth-of-type(2)",
                    "values": {
                        "items": [
                            {
                                "label": "60+",
                                "label_2": "Jaar actief"
                            },
                            {
                                "label": "35+",
                                "label_2": "Leden"
                            },
                            {
                                "label": "3",
                                "label_2": "Competitieteams"
                            },
                            {
                                "label": "2×",
                                "label_2": "Per week training"
                            }
                        ]
                    }
                },
                {
                    "type": "over-ons",
                    "selector": "#over-ons",
                    "values": {
                        "label": "Over ons",
                        "kop": "Meer dan alleen tafeltennis",
                        "tekst": "Bij TTV Merwestad draait het om sport, plezier en verbinding. Of je nu jong of oud bent, beginner of gevorderd — je bent welkom.",
                        "items": [
                            {
                                "icoon": "users",
                                "kop": "Alle niveaus",
                                "tekst": "Of je nu voor het eerst een batje vasthoudt of al jaren competitie speelt — bij ons vind je altijd een passende tafel."
                            },
                            {
                                "icoon": "heart",
                                "kop": "Gezelligheid",
                                "tekst": "Meer dan alleen sport. Na de training schuiven we aan de bar aan voor een drankje en een goed gesprek."
                            },
                            {
                                "icoon": "trophy",
                                "kop": "Competitie",
                                "tekst": "Met 3 teams strijden we in de regionale duocompetitie."
                            }
                        ]
                    }
                },
                {
                    "type": "trainingstijden",
                    "selector": "#trainingstijden",
                    "values": {
                        "label": "Trainingstijden",
                        "kop": "Wanneer kun je spelen?",
                        "tekst": "We trainen meerdere keren per week in de sporthal. Kies de avond die bij jou past en kom gerust een keer vrijblijvend meespelen.",
                        "items": [
                            {
                                "kop": "Dinsdag",
                                "label": "Vanavond!",
                                "label_2": "19:30 – 22:00",
                                "lijst": "Vrij spelen\ncompetitie"
                            },
                            {
                                "kop": "Donderdag",
                                "label_2": "19:30 – 22:00",
                                "lijst": "Vrij spelen\ncompetitie"
                            }
                        ],
                        "tekst_2": "Maria Montessorilaan 3 – Zaal 1, 3312 KJ Dordrecht"
                    }
                },
                {
                    "type": "teams",
                    "selector": "#teams",
                    "values": {
                        "label": "Competitie",
                        "kop": "Onze teams",
                        "tekst": "Met drie teams zijn we actief in de regionale duocompetitie van de NTTB. Bekijk de uitslagen en standen via de links bij elk team.",
                        "items": [
                            {
                                "link": {
                                    "url": "https://ttapp.nl/poule/5022335"
                                },
                                "kop": "Merwestad 1",
                                "tekst": "West - Senioren DUO",
                                "lijst": "4e klasse\nPoule G",
                                "lijst_2": "Gert-Jan\nStefan"
                            },
                            {
                                "link": {
                                    "url": "https://ttapp.nl/poule/5022362"
                                },
                                "kop": "Merwestad 2",
                                "tekst": "West - Senioren DUO",
                                "lijst": "6e klasse\nPoule F",
                                "lijst_2": "Jaap\nGerrit\nDesmond\nArjan"
                            },
                            {
                                "link": {
                                    "url": "https://ttapp.nl/poule/5022369"
                                },
                                "kop": "Merwestad 3",
                                "tekst": "West - Senioren DUO",
                                "lijst": "7e klasse\nPoule A",
                                "lijst_2": "Rob\nRuud\nHenk\nAbdol Majid"
                            }
                        ]
                    }
                },
                {
                    "type": "locatie",
                    "selector": "#locatie",
                    "values": {
                        "label": "Locatie",
                        "kop": "Zo vind je ons",
                        "tekst": "We spelen in het gebouw van Mountain Network op het Leerpark in Dordrecht. Hieronder zie je precies waar je kunt parkeren en hoe je bij de ingang komt.",
                        "afbeelding": {
                            "url": "/map.png",
                            "alt": "Satellietbeeld van de locatie van TTV Merwestad bij Mountain Network op het Leerpark in Dordrecht"
                        },
                        "knop": {
                            "text": "Open in Google Maps",
                            "link": {
                                "url": "https://maps.google.com/?q=Maria+Montessorilaan+3+Dordrecht"
                            }
                        },
                        "items": [
                            {
                                "icoon": "building2",
                                "kop": "Mountain Network",
                                "tekst": "Ons gebouw heet Mountain Network en bevindt zich op het Leerpark in Dordrecht. We zitten in Zaal 1 op de begane grond."
                            },
                            {
                                "icoon": "car",
                                "kop": "Parkeren",
                                "tekst": "Je kunt gratis parkeren aan de achterkant van het gebouw. Let op: de ingang van het gebouw bevindt zich aan de voorkant, aan de kant van het Leerpark."
                            },
                            {
                                "icoon": "map-pin",
                                "kop": "Ingang",
                                "tekst": "Loop vanaf de parkeerplaats om het gebouw heen naar de voorzijde (kant Leerpark). Daar vind je de hoofdingang van Mountain Network."
                            }
                        ]
                    }
                },
                {
                    "type": "lid-worden",
                    "selector": "#lid-worden",
                    "values": {
                        "label": "Lid worden",
                        "kop": "Klaar om mee te spelen?",
                        "tekst": "Word lid van TTV Merwestad en ontdek de leukste tafeltennisvereniging van de regio. Je mag als nieuwkomer 3 keer langs komen om te kijken of het iets voor je is — kom gerust langs om kennis te maken.",
                        "knop": {
                            "text": "Neem contact op",
                            "link": {
                                "url": "mailto:info@ttvmerwestad.nl"
                            }
                        },
                        "knop_2": {
                            "text": "Bekijk trainingstijden",
                            "link": {
                                "url": "#trainingstijden"
                            }
                        }
                    }
                },
                {
                    "type": "contact",
                    "selector": "#contact",
                    "values": {
                        "label": "Contact",
                        "kop": "Stuur ons een bericht",
                        "tekst": "Heb je een vraag, wil je je aanmelden of gewoon even kennismaken? Vul het formulier in en we nemen zo snel mogelijk contact met je op.",
                        "label_2": "Maria Montessorilaan 3 – Zaal 1, 3312 KJ Dordrecht",
                        "knop": {
                            "text": "info@ttvmerwestad.nl",
                            "link": {
                                "url": "mailto:info@ttvmerwestad.nl"
                            }
                        }
                    }
                }
            ]
        }
    ]
}
