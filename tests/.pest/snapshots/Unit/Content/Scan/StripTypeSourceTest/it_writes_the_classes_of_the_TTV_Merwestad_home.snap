// ---- Strook2.php
<?php

namespace App\Cms\Strips;

use Made\CmsPackage\Content\Strips\Fields\Items;
use Made\CmsPackage\Content\Strips\Fields\Text;
use Made\CmsPackage\Content\Strips\StripType;

final class Strook2 extends StripType
{
    public function key(): string
    {
        return 'strook-2';
    }

    public function label(): string
    {
        return 'Strook 2';
    }

    public function fields(): array
    {
        return [
            Items::make('items', [
                Text::make('label')->required(),
                Text::make('label_2')->required(),
            ])->max(4)->required(),
        ];
    }
}
// ---- Teams.php
<?php

namespace App\Cms\Strips;

use Made\CmsPackage\Content\Strips\Fields\Heading;
use Made\CmsPackage\Content\Strips\Fields\Items;
use Made\CmsPackage\Content\Strips\Fields\Link;
use Made\CmsPackage\Content\Strips\Fields\LongText;
use Made\CmsPackage\Content\Strips\Fields\Text;
use Made\CmsPackage\Content\Strips\StripType;

final class Teams extends StripType
{
    public function key(): string
    {
        return 'teams';
    }

    public function fields(): array
    {
        return [
            Text::make('label')->required(),
            Heading::make('kop')->required(),
            LongText::make('tekst')->required(),
            Items::make('items', [
                Link::make('link')->required(),
                Heading::make('kop')->tag('h3')->required(),
                LongText::make('tekst')->required(),
                LongText::make('lijst')->required(),
                LongText::make('lijst_2')->required(),
            ])->max(3)->required(),
        ];
    }
}
// ---- Trainingstijden.php
<?php

namespace App\Cms\Strips;

use Made\CmsPackage\Content\Strips\Fields\Heading;
use Made\CmsPackage\Content\Strips\Fields\Items;
use Made\CmsPackage\Content\Strips\Fields\LongText;
use Made\CmsPackage\Content\Strips\Fields\Text;
use Made\CmsPackage\Content\Strips\StripType;

final class Trainingstijden extends StripType
{
    public function key(): string
    {
        return 'trainingstijden';
    }

    public function fields(): array
    {
        return [
            Text::make('label')->required(),
            Heading::make('kop')->required(),
            LongText::make('tekst')->required(),
            Items::make('items', [
                Heading::make('kop')->tag('h3')->required(),
                Text::make('label'),
                Text::make('label_2')->required(),
                LongText::make('lijst')->required(),
            ])->max(2)->required(),
            LongText::make('tekst_2')->required(),
        ];
    }
}
