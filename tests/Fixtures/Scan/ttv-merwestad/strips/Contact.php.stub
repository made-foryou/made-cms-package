<?php

namespace App\Cms\Strips;

use Made\CmsPackage\Content\Strips\Fields\Heading;
use Made\CmsPackage\Content\Strips\Fields\LongText;
use Made\CmsPackage\Content\Strips\Fields\Text;
use Made\CmsPackage\Content\Strips\StripType;

final class Contact extends StripType
{
    public function key(): string
    {
        return 'contact';
    }

    public function description(): ?string
    {
        return 'Contactgegevens met het contactformulier van de site.';
    }

    public function fields(): array
    {
        return [
            Text::make('anker')->default('contact')->hint('Het #-adres van deze strook in het menu.'),
            Text::make('label'),
            Heading::make('kop')->required(),
            LongText::make('intro'),
            Text::make('adres'),
            Text::make('email')->label('E-mailadres'),
            Heading::make('bedankt_kop')->tag('h3')->label('Kop na versturen')->default('Bericht verstuurd!'),
            LongText::make('bedankt_tekst')->label('Tekst na versturen'),
        ];
    }
}
